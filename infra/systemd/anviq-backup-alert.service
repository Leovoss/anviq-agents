[Unit]
Description=Notify operators when a production backup fails

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/anviq-host-alert backup-failure "Nightly backup failed. Inspect anviq-backup.service on the server."
StateDirectory=anviq/alerts
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/anviq/alerts
PrivateTmp=true
