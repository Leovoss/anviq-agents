{
  "name": "@anviq/worker",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev-watch.mjs src/index.ts",
    "build": "node ../../scripts/build-server.mjs src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@anviq/adapter-kit": "workspace:*",
    "@anviq/adapters": "workspace:*",
    "@anviq/core": "workspace:*",
    "@anviq/db": "workspace:*",
    "@anviq/logging": "workspace:*",
    "@anviq/memory": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
