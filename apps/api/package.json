{
  "name": "@anviq/api",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev-watch.mjs src/index.ts",
    "build": "node ../../scripts/build-server.mjs src/index.ts src/cli/migrate-database.ts src/cli/bootstrap-owner.ts",
    "start": "node --enable-source-maps dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/api/src",
    "db:migrate": "tsx src/cli/migrate-database.ts",
    "db:deploy": "node --enable-source-maps dist/cli/migrate-database.js",
    "secrets:infisical": "tsx src/cli/secrets-infisical.ts",
    "content-encryption": "tsx src/cli/content-encryption.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@orpc/server": "1.15.7",
    "@anviq/adapter-kit": "workspace:*",
    "@anviq/adapters": "workspace:*",
    "@anviq/auth": "workspace:*",
    "@anviq/contracts": "workspace:*",
    "@anviq/core": "workspace:*",
    "@anviq/db": "workspace:*",
    "@anviq/logging": "workspace:*",
    "@anviq/memory": "workspace:*",
    "hono": "4.13.13",
    "mermaid": "11.17.2"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
